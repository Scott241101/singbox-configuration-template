{
  "log": {
    "level": "info",
    "output": "日志记录路径/文件名",
    "timestamp": true
  },

  "inbounds": [
    {
      "type": "vless",
      "tag": "reality-in",
      "listen": "::",
      "listen_port": 443,
      "users": [
        {
          "name": "用户名",
          "uuid": "用户uuid"   
        },

        {
          "name": "用户名",
          "uuid": "用户uuid"
        },

        {
          "name": "用户名",
          "uuid": "用户uuid"   
        }
      //使用sing-box generate uuid生成uuid
      ],
      "tls": {
        "enabled": true,
        "server_name": "www.bing.com",
        "reality": {
          "enabled": true,
          "private_key": "reality私钥，使用sing-box generate reality-keypair生成密钥对",
          "short_id": [
            "服务端id，格式为8位16进制数字和字母"
            ],
	        "handshake": {
            "server": "www.bing.com",
            "server_port": 443
          }
        }
      }
    }
  ],

 "outbounds":[
    {
      "type": "direct",
      "tag": "direct"
    }
 ],
 "route": {
    "rules": [
      {
       "action": "sniff"
      },
      {
       "protocol": "bittorrent",
       "action": "reject"
      },
      {
       "protocol": "dns",
       "action": "hijack-dns"
      },
      {
        "inbound": "reality-in",
        "action": "route",
        "outbound": "direct"
      }
    ]
  }
}
