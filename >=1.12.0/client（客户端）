{
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },

  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "dns-intl",
        "server": "1.1.1.1",
        "detour": "vless-out"
      }
    ]
  },

  "inbounds": [
   {
      "type": "http",
      "listen": "127.0.0.1",
      "listen_port": 10809
    }
  ],

  "outbounds": [
    {
      "type": "vless",
      "tag": "vless-out",
      "server": "服务器地址",
      "server_port": 443,
      "uuid": "用户uuid",
      "flow": "",
      "tls": {
        "enabled": true,
        "server_name": "www.bing.com", //服务器端伪装的域名，需要与服务端保持一致
        "reality": {
          "enabled": true,
          "public_key": "reality公钥，使用sing-box generate reality-keypair生成密钥对",
          "short_id": "服务端short id，需要与服务端匹配",
        },
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],

 "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
      "protocol": "bittorrent",
      "outbound": "direct"
      },
      {
       "protocol": "dns",
       "action": "hijack-dns"
      },
      {
       "action": "route",
       "outbound": "vless-out"
      } 
    ]
  }
}
