{
  "log": {
    "level": "info",
    "output": "日志记录路径/文件名",
	//建议使用/var/log/sing-box/sing-box.log
    "timestamp": true
  },

  "inbounds": [
    {
      "type": "vless",
      "tag": "reality-in",
      "listen": "::",
      "listen_port": 443,
      "users": [
        {
          "name": "用户名",
          "uuid": "用户uuid"   
        },

        {
          "name": "用户名",
          "uuid": "用户uuid"
        },

        {
          "name": "用户名",
          "uuid": "用户uuid"   
        }
      //使用sing-box generate uuid生成uuid
      ],
      "tls": {
        "enabled": true,
        "server_name": "www.bing.com",
		//你想要伪装的域名，在azure上建议使用microsoft.com及其子域名、www.bing.com、www.msn.com，在AWS上建议使用amazon.com及其子域名，在GCP上建议使用www.fandom.com
		//伪装的域名必须真实且可在大陆境内免翻墙访问
		//最好与云平台主域名及其相关域名切合（如：在azure上使用microsoft.com或者www.bing.com），如果主域名不可免翻墙访问，则切换其他通用非厂商关联型域名（如：www.fandom.com，www.speedtest.net）
        "reality": {
          "enabled": true,
          "private_key": "reality私钥",
		  //使用sing-box generate reality-keypair生成密钥对
          "short_id": [
            "服务端id，格式为8位16进制数字和字母"
            ],
	        "handshake": {
            "server": "www.bing.com", 
			//与上面server_name需保持一致
            "server_port": 443
          }
        }
      }
    }
  ],

 "outbounds":[
    {
      "type": "direct",
      "tag": "direct"
    }
 ],
 "route": {
    "rules": [
      {
       "action": "sniff"
      },
      {
       "protocol": "bittorrent",
       "action": "reject"
      },
      {
        "inbound": "reality-in",
        "action": "route",
        "outbound": "direct"
      }
    ]
  }
}
