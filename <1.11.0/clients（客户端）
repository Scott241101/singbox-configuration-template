{
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },

  "dns": {
    "servers": [
      {
        "tag": "dns-remote",
        "address": "https://1.1.1.1/dns-query"
      }
    ]
  },

  "inbounds": [
   {
      "type": "http",
      "listen": "127.0.0.1",
      "listen_port": 10809
    }
  ],

  "outbounds": [
    {
      "type": "vless",
      "server": "vpn服务器地址",
      "server_port": 443,
      "uuid": "用户uuid",
      "flow": "",
      "tls": {
        "enabled": true,
        "server_name": "www.bing.com", //服务端伪装的域名，需要与服务端保持一致
        "reality": {
          "enabled": true,
          "public_key": "reality公钥，使用sing-box generate reality-keypair生成密钥对",
          "short_id": "服务器short id，需匹配服务端的short id",
        },
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],

  "route": {
    "rules": [
      {
        "domain_suffix": ["ipinfo.io"],
        "outbound": "direct"
      }
    ]
  }
}
